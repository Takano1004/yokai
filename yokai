  return statusNames.map(function(s, i){
    var hasA = cl.bs_A[i];
    var actual = meas.actual[i];
    var map = {};
    if (actual === null) {
      for (var b = 0; b <= sumB1; b++) map[b] = null; // 不明
      return {map:map, hasA:hasA, unknown:true};
    }
    var isHP = (i === 0), growPat = selectedYokai.growPat[i], bs = selectedYokai.bs[i];
    for (var b1 = 0; b1 <= sumB1; b1++) {
      if (hasA) {
        var list = [];
        for (var a = 0; a <= MAX_A; a++) {
          if (calcStatus(growPat, bs, a, b1, meas.b2[i], meas.cb[i], meas.level, isHP) === actual) list.push(a);
        }
        if (list.length) map[b1] = list;
      } else {
        if (calcStatus(growPat, bs, 0, b1, meas.b2[i], meas.cb[i], meas.level, isHP) === actual) map[b1] = [0];
      }
    }
    return {map:map, hasA:hasA, unknown:false};
  });
}

function intersectSolutions(s1, s2){
  return s1.map(function(a, i){
    var b = s2[i];
    if (b.unknown) return a;
    if (a.unknown) return b;
    var map = {};
    Object.keys(a.map).forEach(function(k){
      if (!(k in b.map)) return;
      var la = a.map[k], lb = b.map[k];
      if (la === null) { map[k] = lb; return; }
      if (lb === null) { map[k] = la; return; }
      var inter = la.filter(function(v){ return lb.indexOf(v) > -1; });
      if (inter.length) map[k] = inter;
    });
    return {map:map, hasA:a.hasA, unknown:false};
  });
}

function applyKnownB1(sols, known){
  return sols.map(function(s, i){
    if (known[i] === null) return s;
    var map = {};
    if (known[i] in s.map || (s.unknown && known[i] <= 99)) {
      map[known[i]] = s.map[known[i]] !== undefined ? s.map[known[i]] : null;
    }
    return {map:map, hasA:s.hasA, unknown:s.unknown};
  });
}

function enumerateCombos(sols, sumB1, limit){
  var keys = sols.map(function(s){
    return Object.keys(s.map).map(Number).sort(function(a,b){ return a-b; });
  });
  var combos = [], overflow = false;
  (function dfs(i, remain, acc){
    if (overflow) return;
    if (i === 5) { if (remain === 0) { if (combos.length >= limit) { overflow = true; return; } combos.push(acc.slice()); } return; }
    for (var k = 0; k < keys[i].length; k++) {
      var b = keys[i][k];
      if (b > remain) break;
      acc.push(b);
      dfs(i + 1, remain - b, acc);
      acc.pop();
      if (overflow) return;
    }
  })(0, sumB1, []);
  return {combos:combos, overflow:overflow};
}

function fmtList(list){
  if (list === null) return '不明';
  if (list.length === 1) return String(list[0]);
  if (list.length <= 6) return list.join(' / ');
  return list[0] + '〜' + list[list.length-1] + '（' + list.length + '通り）';
}

function runCalc(){
  var $result = document.getElementById('result');
  if (!selectedYokai) {
    $result.innerHTML = '<div class="msg">①で妖怪を選ぶと計算できます。</div>';
    return;
  }
  var level = parseInt(document.getElementById('level').value, 10);
  if (!(level >= 1 && level <= 99)) {
    $result.innerHTML = '<div class="msg">レベルは1〜99で入力してください。</div>';
    return;
  }
  var sumB1 = parseInt(document.getElementById('b1sum').value, 10);
  if (!(sumB1 >= 0 && sumB1 <= 30)) {
    $result.innerHTML = '<div class="msg">個体値B_1の合計は0〜30で入力してください。通常は10です。</div>';
    return;
  }

  var meas1 = {level:level, cb:readRow('cb', 0), b2:readRow('ivb2', 0), actual:readRow('actual')};
  if (meas1.actual.every(function(v){ return v === null; })) {
    $result.innerHTML = '<div class="msg">③にゲーム内のステータスを入力してください。1項目でも埋まれば計算を始められます。</div>';
    return;
  }

  var sols = solveMeasurement(meas1, sumB1);

  // 2回目の測定
  var actual2 = readRow('actual2');
  var used2 = actual2.some(function(v){ return v !== null; });
  if (used2) {
    var level2 = parseInt(document.getElementById('level2').value, 10);
    if (!(level2 >= 1 && level2 <= 99)) {
      $result.innerHTML = '<div class="msg">2回目のレベルは1〜99で入力してください。</div>';
      return;
    }
    var meas2 = {level:level2, cb:readRow('cb2', 0), b2:readRow('ivb2b', 0), actual:actual2};
    sols = intersectSolutions(sols, solveMeasurement(meas2, sumB1));
  }

  // 既知のB_1で絞り込み
  var knownB1 = readRow('ivb1');
  if (knownB1.some(function(v){ return v !== null; })) {
    sols = applyKnownB1(sols, knownB1);
  }

  var res = enumerateCombos(sols, sumB1, 5000);
  var combos = res.combos;
  var cl = classes[selectedYokai.class];

  var html = '';

  if (combos.length === 0) {
    html += '<div class="msg">条件に合う組み合わせが見つかりません。レベル・性格ボーナス・個体値B_2・入力したステータスのどれかがずれている可能性があります。B_1の合計（通常10）も確認してください。</div>';
    document.getElementById('result').innerHTML = html;
    return;
  }

  // 各ステータスの取りうる値を組み合わせから集計
  var b1Sets = [[],[],[],[],[]], aSets = [[],[],[],[],[]], aUnknown = [false,false,false,false,false];
  combos.forEach(function(c){
    c.forEach(function(b, i){
      if (b1Sets[i].indexOf(b) < 0) b1Sets[i].push(b);
      var al = sols[i].map[b];
      if (al === null) { aUnknown[i] = true; return; }
      al.forEach(function(a){ if (aSets[i].indexOf(a) < 0) aSets[i].push(a); });
    });
  });
  b1Sets.forEach(function(l){ l.sort(function(a,b){return a-b;}); });
  aSets.forEach(function(l){ l.sort(function(a,b){return a-b;}); });

  html += '<div class="result-card">';
  html += '<h3 class="result-title">'+selectedYokai.name+'（Lv.'+level+'／'+cl.name+'）の推定結果</h3>';
  html += '<p class="result-sub">B_1の合計を'+sumB1+'として、実測ステータスに合う個体値B_1とAの組み合わせを総当たりしました。'+
    (used2 ? '2回目の測定も条件に含めています。' : '')+'</p>';
  html += '<div class="scroll-x"><table class="res"><thead><tr><th style="text-align:left">ステータス</th><th>種族値</th><th>伸び方</th><th>実測値</th><th>個体値B_1</th><th>個体値A</th></tr></thead><tbody>';
  statusNames.forEach(function(s, i){
    var b1Txt = fmtList(b1Sets[i]);
    var aTxt = cl.bs_A[i] ? (aUnknown[i] && aSets[i].length === 0 ? '不明' : fmtList(aSets[i])) : '—';
    var b1Badge = b1Sets[i].length === 1 ? '<span class="badge hit">確定</span> ' : '';
    var aBadge = cl.bs_A[i] ? (aSets[i].length === 1 && !aUnknown[i] ? '<span class="badge hit">確定</span> ' : '') : '';
    html += '<tr><td class="stat-name">'+s.displayName+'</td>'+
      '<td>'+selectedYokai.bs[i]+'</td>'+
      '<td>'+growPatName[selectedYokai.growPat[i]]+'</td>'+
      '<td>'+(meas1.actual[i] === null ? '—' : meas1.actual[i])+'</td>'+
      '<td>'+b1Badge+'<span class="cand-list">'+b1Txt+'</span></td>'+
      '<td>'+aBadge+(cl.bs_A[i] ? '<span class="cand-list">'+aTxt+'</span>' : '<span class="badge fixed">なし</span>')+'</td></tr>';
  });
  html += '</tbody></table></div></div>';

  // 組み合わせ一覧
  html += '<div class="result-card">';
  html += '<div class="combo-head"><h3 class="result-title" style="margin:0">組み合わせ候補</h3>'+
    '<span class="combo-count">'+(res.overflow ? '5000件以上' : combos.length+'件')+
    (combos.length > 200 ? '（先頭200件を表示）' : '')+'</span></div>';
  html += '<p class="result-sub">各マスは「B_1（A）」の形式です。Aを持たないステータスは B_1 のみ表示します。</p>';
  html += '<div class="scroll-x"><table class="combo"><thead><tr><th></th>';
  statusNames.forEach(function(s){ html += '<th>'+s.displayName+'</th>'; });
  html += '</tr></thead><tbody>';
  combos.slice(0, 200).forEach(function(c, idx){
    html += '<tr><td class="idx">'+(idx+1)+'</td>';
    c.forEach(function(b, i){
      var al = sols[i].map[b];
      var aTxt = cl.bs_A[i] ? '<span class="av">（'+(al === null ? '?' : fmtList(al))+'）</span>' : '';
      html += '<td><span class="b1v">'+b+'</span>'+aTxt+'</td>';
    });
    html += '</tr>';
  });
  html += '</tbody></table></div></div>';

  if (combos.length === 1) {
    html += '<div class="msg info">候補が1つに決まりました。この組み合わせがこの妖怪の個体値です。</div>';
  } else {
    html += '<div class="msg info">候補が複数あります。レベルを上げてから測り直した数値を「2回目の測定」に入れると、ほぼ1つに絞り込めます。空欄のステータスを埋めるのも効果的です。</div>';
  }

  document.getElementById('result').innerHTML = html;
  document.getElementById('result').scrollIntoView({behavior:'smooth', block:'start'});
}

document.getElementById('calcBtn').addEventListener('click', runCalc);
</script>
</body>
