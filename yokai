function renderSelectedInfo(){
  if (!selectedYokai) { $selInfo.textContent=''; return; }
  var cl = classes[selectedYokai.class];
  var bsStr = statusNames.map(function(s,i){ return s.displayName+' '+selectedYokai.bs[i]; }).join(' / ');
  var aStr = statusNames.filter(function(s,i){ return cl.bs_A[i]; }).map(function(s){ return s.displayName; }).join('・');
