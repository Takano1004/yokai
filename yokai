    return y.name.indexOf(term) > -1 || y.furigana.indexOf(term) > -1;
  }).slice(0, 40);
  if (matches.length === 0) { $list.classList.remove('open'); $list.innerHTML=''; return; }
  $list.innerHTML = matches.map(function(y){
    return '<div class="picker-item" data-num="'+y.num+'"><span>'+y.name+'</span><small>'+classes[y.class].name+'</small></div>';
  }).join('');
